# Local working material, never published
docs/
ruff.toml

# Credentials: IBM Quantum API keys, instance CRNs, qBraid/Quantum Rings tokens.
# Never commit these in any form. The notebooks read them from a prompt or from .env.
.env
.env.*
*.env
secrets/
secrets.*
credentials*
*.key
*.token
*api_key*
*apikey*
*crn*
qiskit-ibm.json
.qiskit/
.qbraid/
.quantumrings/

# Headless verification copies: docs/build/verify.py writes exec_<name>.ipynb into the
# repo root. Untracked and easy to sweep up with `git add -A`; never publish them.
exec_*.ipynb

# Python / Jupyter
__pycache__/
.ruff_cache/
.mypy_cache/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# LaTeX build files (the PDFs are kept)
bootcamp/*/src/notes.pdf
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# Large or binary data
*.h5
*.hdf5
*.pkl
*.pth

# OS
.DS_Store
